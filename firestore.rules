rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // OTP codes — unauthenticated read/write for pre-login flows.
    match /email_otps/{email} {
      allow read, write: if true;
    }

    // Deletion flags — public read/write.
    match /email_index/{email} {
      allow read, write: if true;
    }

    // Users — authenticated access only.
    match /User/{userId} {
      allow get: if request.auth != null &&
                    (request.auth.uid == userId ||
                     get(/databases/$(database)/documents/User/$(request.auth.uid)).data.user_role == 'admin');

      // Normal write: owner writes their own doc.
      // Migration write: the newly-created account (new_uid) is allowed to
      //   write/delete the OLD uid's doc so cleanup succeeds after sign-in swap.
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/PendingEmailVerification/$(userId)) &&
         get(/databases/$(database)/documents/PendingEmailVerification/$(userId)).data.new_uid == request.auth.uid)
      );
    }

    // AuthIndex — maps UID → auth email for login-by-ID resolution.
    match /AuthIndex/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/PendingEmailVerification/$(userId)) &&
         get(/databases/$(database)/documents/PendingEmailVerification/$(userId)).data.new_uid == request.auth.uid)
      );
    }

    // PendingEmailVerification — created by old UID, deleted by either UID.
    match /PendingEmailVerification/{oldUid} {
      allow read, create: if request.auth != null && request.auth.uid == oldUid;
      allow delete: if request.auth != null && (
        request.auth.uid == oldUid ||
        resource.data.new_uid == request.auth.uid
      );
    }

    // Counters — authenticated users only.
    match /Counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // Everything else requires authentication.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
