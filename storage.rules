rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Historical sales Excel — authenticated users only (admin UI enforces role).
    match /sales_records/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Everything else requires authentication.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
